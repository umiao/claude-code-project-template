{# Life category sidebar widget for NexT theme #}
{% set life_posts = [] %}
{% for post in site.posts.data %}
  {% set is_life = false %}
  {% for cat in post.categories.data %}
    {% if cat.name === 'Life' %}
      {% set is_life = true %}
    {% endif %}
  {% endfor %}
  {% if is_life %}
    {% set life_posts = life_posts.concat([post]) %}
  {% endif %}
{% endfor %}

{% if life_posts.length > 0 %}
<div class="life-sidebar-widget">
  <h3 class="life-widget-title" style="margin: 20px 0 10px; font-size: 14px; font-weight: 600; color: #555; border-bottom: 1px solid #eee; padding-bottom: 5px;">
    Life
  </h3>
  <ul style="list-style: none; padding: 0; margin: 0;">
    {% for post in life_posts %}
    <li style="margin-bottom: 8px; font-size: 13px;">
      <a href="{{ url_for(post.path) }}" style="color: #555; text-decoration: none;">
        {{ post.title }}
      </a>
      <span style="color: #999; font-size: 11px; display: block;">
        {{ date(post.date, 'YYYY-MM-DD') }}
      </span>
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}
