// -------------------------------------------------------
// Index page card enhancements (T-P0-13)
// -------------------------------------------------------

// Post card hover effect -- subtle shadow, no vertical shift
.post-block
  transition box-shadow 0.3s ease
  &:hover
    box-shadow 0 4px 16px rgba(0, 0, 0, 0.12)

// Constrain excerpt images to consistent height without distortion
.posts-expand .post-body img
  max-height 320px
  width 100%
  object-fit cover
  border-radius 4px
  margin-bottom 0.8em

// Clamp excerpt text so cards stay roughly consistent height
.posts-expand .post-body > p
  max-height 6em
  overflow hidden
  display -webkit-box
  -webkit-line-clamp 4
  -webkit-box-orient vertical

// Tighten spacing between post header and body
.posts-expand .post-header
  margin-bottom 0.5em

// Description line styling
.post-description
  color #888
  font-size 0.9em
  margin-top 0.3em

// Mobile responsive adjustments
@media (max-width: 767px)
  .posts-expand .post-body img
    max-height 200px
  .posts-expand .post-body > p
    max-height 5em
    -webkit-line-clamp 3

// -------------------------------------------------------
// Series badge in post-meta (T-P2-16)
// -------------------------------------------------------

.post-meta-series .series-badge
  display inline-block
  padding 0 6px
  border-radius 3px
  background-color rgba(55, 198, 192, 0.12)
  color #37c6c0
  font-size 0.85em
  font-weight 600
  text-decoration none
  transition background-color 0.2s ease
  &:hover
    background-color rgba(55, 198, 192, 0.25)
    text-decoration none

// Dark mode override
.darkmode .post-meta-series .series-badge
  background-color rgba(55, 198, 192, 0.18)
  color #5dd9d3

// -------------------------------------------------------
// Mermaid diagram container -- scrollable for large diagrams
.mermaid-container
  max-height 80vh
  overflow auto
  border 1px solid var(--body-bg-color)
  border-radius 4px
  margin 1em 0

// Fallback UX when mermaid.js fails to load or hasn't run yet.
// Once mermaid renders, it replaces the <pre> with an <svg>,
// so these styles only apply while the raw code is still visible.
pre > code.mermaid
  font-size 0
  &::before
    font-size 1rem
    content "Diagram loading... If it doesn't appear, please refresh or check your network connection."
    display block
    padding 1em
    color #888
    text-align center
