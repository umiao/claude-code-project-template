// -------------------------------------------------------
// Series badge in post-meta (T-P2-16)
// -------------------------------------------------------

.post-meta-series .series-badge
  display inline-block
  padding 0 6px
  border-radius 3px
  background-color rgba(55, 198, 192, 0.12)
  color #37c6c0
  font-size 0.85em
  font-weight 600
  text-decoration none
  transition background-color 0.2s ease
  &:hover
    background-color rgba(55, 198, 192, 0.25)
    text-decoration none

// Dark mode override
.darkmode .post-meta-series .series-badge
  background-color rgba(55, 198, 192, 0.18)
  color #5dd9d3

// -------------------------------------------------------
// Mermaid diagram container -- scrollable for large diagrams
.mermaid-container
  max-height 80vh
  overflow auto
  border 1px solid var(--body-bg-color)
  border-radius 4px
  margin 1em 0

// Fallback UX when mermaid.js fails to load or hasn't run yet.
// Once mermaid renders, it replaces the <pre> with an <svg>,
// so these styles only apply while the raw code is still visible.
pre > code.mermaid
  font-size 0
  &::before
    font-size 1rem
    content "Diagram loading... If it doesn't appear, please refresh or check your network connection."
    display block
    padding 1em
    color #888
    text-align center

// -------------------------------------------------------
// Life sidebar widget (relocated outside panel container)
// -------------------------------------------------------
.sidebar-life
  margin-top 12px
  padding 10px 15px
  background var(--content-bg-color)
  border-radius 8px
  box-shadow 0 2px 8px rgba(0, 0, 0, 0.08)

.life-widget-title
  margin 0 0 10px
  font-size 14px
  font-weight 600
  color #555
  border-bottom 1px solid #eee
  padding-bottom 5px

.life-widget-list
  list-style none
  padding 0
  margin 0

.life-widget-item
  margin-bottom 8px
  font-size 13px

.life-sidebar-widget a
  color var(--text-color)
  text-decoration none
  &:hover
    color var(--link-hover-color)

.life-widget-date
  color #999
  font-size 11px
  display block
